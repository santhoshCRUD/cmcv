PORT=7000

MONGO_URI=mongodb://127.0.0.1:27017/cmc_connect_v2

JWT_SECRET=cmc_connect_v2_secret_key

JWT_EXPIRES_IN=1d

# Module guide chatbot (optional). Without a key the guide still works,
# answering from the built-in knowledge base by keyword search.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5

# Where form attachments are stored (default: ./uploads, served at /uploads)
# UPLOAD_DIR=/var/cmc-connect/uploads
